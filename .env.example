# ═══════════════════════════════════════════════════════════
#  Fable | VPN — настройки. Скопируй в .env:  cp .env.example .env
#  Все пароли/секреты ниже сгенерируй:  openssl rand -hex 24
# ═══════════════════════════════════════════════════════════

# ───────── Telegram ─────────
# Токен от @BotFather
BOT_TOKEN=
# Telegram ID владельцев через запятую (узнать: @userinfobot). Владельцам доступно ВСЁ.
OWNER_IDS=
# Ссылка для кнопки «Поддержка» (можно потом поменять в админке → Настройки)
SUPPORT_URL=https://t.me/your_support

# ───────── Публичный адрес бота ─────────
# Домен, который смотрит на этот сервер (HTTPS обязателен). Нужен для вебхуков ЮKassa
# и для страниц /dl и /add (кнопки «Скачать Happ» и «Добавить подписку»).
BOT_DOMAIN=bot.example.com
PUBLIC_BASE_URL=https://bot.example.com
# Случайная строка — часть адреса вебхуков (защита от посторонних запросов)
WEBHOOK_SECRET=

# ───────── База данных ─────────
# Пароль PostgreSQL (только буквы и цифры, например hex). Используется compose-файлом.
POSTGRES_PASSWORD=

# ───────── Общее ─────────
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# ───────── Remnawave (панель VPN) ─────────
# Адрес панели. Проще всего публичный: https://panel.example.com
# Если бот в одной docker-сети с панелью: http://remnawave:3000
REMNAWAVE_URL=https://panel.example.com
# Токен: Панель → Settings → API Tokens → Create (с правами на users, hwid, squads, nodes, system)
REMNAWAVE_TOKEN=
# Бот добавляет X-Forwarded-For/Proto: https — нужно при доступе по http напрямую. Оставь true.
REMNAWAVE_PROXY_HEADERS=true
# Только если панель закрыта защитой (иначе пусто):
#   Caddy Security → ключ в заголовок X-Api-Key;  cookie-защита → name=value
REMNAWAVE_CADDY_KEY=
REMNAWAVE_COOKIE=
# Секрет вебхуков Remnawave = WEBHOOK_SECRET_HEADER из .env панели (необязательно, но желательно)
REMNAWAVE_WEBHOOK_SECRET=

# Сквады для тарифов можно выбрать позже в админке (Тарифы → Сквады).
# Здесь — необязательное начальное значение (UUID через запятую).
LITE_SQUADS=
PREMIUM_SQUADS=

# ───────── ЮKassa ─────────
# Личный кабинет ЮKassa → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Передавать данные чека (54-ФЗ для ИП/ООО или автоотправка для самозанятых). Бот попросит email.
YOOKASSA_RECEIPTS=true
# Ставка НДС в чеке: 1 = без НДС (самозанятые, УСН без НДС). Остальные коды — в документации ЮKassa (раздел «Чеки»).
YOOKASSA_VAT_CODE=1
# Система налогообложения (нужна, только если в магазине их несколько): 1 ОСН, 2 УСН доходы, 3 УСН доходы-расходы, 4 ЕНВД, 5 ЕСХН, 6 Патент
YOOKASSA_TAX_SYSTEM_CODE=
# Принимать уведомления только с IP-адресов ЮKassa (нужен реверс-прокси, передающий X-Forwarded-For)
YOOKASSA_CHECK_IP=false

# ───────── Бэкапы ─────────
# В какой час (по TIMEZONE) раз в сутки присылать бэкап БД владельцам
BACKUP_HOUR=4
# Или в конкретный чат/канал (бот должен быть админом):
BACKUP_CHAT_ID=
